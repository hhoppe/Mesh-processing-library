# See https://clang.llvm.org/docs/ClangFormatStyleOptions.html
# clang-format -style=google -dump-config
# clang-format -i `allC`

BasedOnStyle: Google
ColumnLimit: 119                            # default is 80; Google default is 80.

Language: Cpp                               # default is Cpp; Google default is Cpp.
# Standard: Latest                          # default is Latest; Google default is Auto; also: Cpp17, Cpp20.
BreakTemplateDeclarations: MultiLine        # default is Multiline; Google default is Yes.
AllowShortCaseLabelsOnASingleLine: true     # default is true; Google default is false.
DerivePointerAlignment: false               # default is false; Google default is true.
ReflowComments: false                       # default is Always; Google default is Always.
IncludeBlocks: Preserve                     # default is Preserve; Google default is Regroup.
RequiresClausePosition: SingleLine          # default is OwnLine; Google default is OwnLine.
# AllowShortBlocksOnASingleLine: Always       # default is Never; Google default is Never.
# AllowShortCompoundRequirementOnASingleLine: true
# ForEachMacros: ['foreach', 'Q_FOREACH', 'BOOST_FOREACH', 'for_int', 'for_intL', 'for_size_t']
# SpaceBeforeParens: Custom
# SpaceBeforeParensOptions:
#   AfterForeachMacros: false

# AllowShortFunctionsOnASingleLine: Inline  # default is All
# CommentPragmas: '^///'                    # default is '^ IWYU pragma:'; however, it still indents it.
# Standard: Latest                          # default is Auto  # not recognized by Visual Studio

# StatementMacros: ['Q_UNUSED', 'QT_REQUIRE_VERSION']
# MaxEmptyLinesToKeep: 1
