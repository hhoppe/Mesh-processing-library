# clang-tidy --verify-config --config-file=.clang-tidy
# clang-tidy --dump-config --config-file=.clang-tidy libHh/Grid.cpp -- -I.
# clang-tidy --enable-check-profile --checks='-*,bugprone-*' Filterframe/Filterframe.cpp -- -I. 1>/dev/null  # Timings.
# clang-tidy --enable-check-profile Filterframe/Filterframe.cpp -- -I.  # Timings.
# clang-tidy --checks='-*,modernize-use-nodiscard' Filterframe/Filterframe.cpp -- -I.
# cd ~/git/mesh_processing; export PATH="/cygdrive/c/progra~1/LLVM/bin/:$PATH"; clang-tidy Filterimage/Filterimage.cpp -- -I.
# ... | grep --line-buffered -E '^[^[:space:]].*:[0-9]+:[0-9]+: (warning|error|note):' | sort -u
#
# cd ~/git/mesh_processing; exclude1="libHwX|" exclude2="" params="-I./libHwWindows"; export PATH="/cygdrive/c/progra~1/LLVM/bin/:$PATH"; (ls **/*.cpp | grep -vE "${exclude1}precompiled_libHh"; ls ../hh_src/**/*.cpp | grep -vE "${exclude2}/test/|_old/|_other/|G3dOGL_notes|Repository|/ptc|/streamonfile") | xargs -P 24 -I {} clang-tidy --config-file="$HOME/git/mesh_processing/.clang-tidy" --quiet {} -- -I. $params |& grep -v --line-buffered -E "^[0-9]+ warnings generated"; (exit ${PIPESTATUS[1]})
#
# b 'cd ~/git/mesh_processing; exclude1="libHwWindows|" exclude2="clip.cpp|hlaunch.cpp|Filterterrain.cpp|TerrainIO.cpp|" params="-I./libHwX"; (ls **/*.cpp | grep -vE "${exclude1}precompiled_libHh"; ls ../hh_src/**/*.cpp | grep -vE "${exclude2}/test/|_old/|_other/|G3dOGL_notes|Repository|/ptc|/streamonfile") | xargs -P 24 -I {} clang-tidy --config-file="$HOME/git/mesh_processing/.clang-tidy" --quiet {} -- -I. $params |& grep -v --line-buffered -E "^[0-9]+ warnings generated"; (exit ${PIPESTATUS[1]})'

Checks:
  # Default-included: - 'clang-diagnostic-*'
  - '-clang-diagnostic-pragma-pack'
  # Default-included: - 'clang-analyzer-*'
  - 'bugprone-*'
  - '-bugprone-easily-swappable-parameters'
  - '-bugprone-narrowing-conversions'
  - '-bugprone-branch-clone'
  - '-bugprone-exception-escape'
  - '-bugprone-unhandled-exception-at-new'
  - '-bugprone-macro-parentheses'
  - '-bugprone-assignment-in-if-condition'
  - '-bugprone-crtp-constructor-accessibility'
  - '-bugprone-unchecked-optional-access'
  - '-bugprone-incorrect-roundings'
  - '-bugprone-inc-dec-in-conditions'
  # LLVM 22/23 moved several checks out of the `cert-*`, `hicpp-*`, `google-*`, and `fuchsia-*` modules (which are
  # never enabled here) into the modules enabled below, and added some new ones.  The old names survive as aliases, so
  # these checks turned on silently.  The disabled ones below conflict with deliberate conventions of this codebase.
  # Disabling a check that an older clang-tidy does not know is silently ignored, so these entries remain compatible
  # with LLVM 21; only `--verify-config` reports them there as unknown.
  - '-bugprone-signed-bitwise'  # Was `hicpp-signed-bitwise`; bit manipulation on signed `int` is intentional.
  - '-bugprone-throwing-static-initialization'  # Was `cert-err58-cpp`; namespace-scope containers and strings abound.
  - '-bugprone-std-exception-baseclass'  # `throw string(...)` and `throw "..."` are caught locally in VideoViewer.
  - '-bugprone-unchecked-string-to-number-conversion'  # `atoi()` and `atof()` parse already-validated argument strings.
  - '-bugprone-derived-method-shadowing-base-method'  # Wrapper classes intentionally hide non-virtual base methods.
  - '-bugprone-std-namespace-modification'  # Only `std::hash` specializations, which are well-defined.
  - '-bugprone-random-generator-seed'  # Was `cert-msc51-cpp`; a default seed gives reproducible results.
  - 'performance-*'
  - '-performance-enum-size'
  - '-performance-inefficient-string-concatenation'
  - '-performance-no-int-to-ptr'
  - 'misc-*'
  - '-misc-include-cleaner'
  # misc-const-correctness is worth running occasionally (--checks='-*,misc-const-correctness'), with its output
  # filtered by hand.  Its analysis misses writes through `*p++`, in `if constexpr` branches, and in fold expressions,
  # and pointers that are returned or stored as non-const, leaving about 50 false positives: too many for NOLINT.
  # Views, scope guards, and file handles are also intentionally left non-const.
  - '-misc-const-correctness'
  - '-misc-non-private-member-variables-in-classes'
  - '-misc-use-anonymous-namespace'
  - '-misc-no-recursion'
  - '-misc-unconventional-assign-operator'
  - '-misc-misplaced-const'
  - '-misc-confusable-identifiers'
  - '-misc-explicit-constructor'  # Was `google-explicit-constructor`; the implicit conversions here are intentional.
  - '-misc-override-with-different-visibility'  # Virtual functions are deliberately overridden as private.
  - '-misc-multiple-inheritance'  # Was `fuchsia-multiple-inheritance`; used to combine storage with an interface.
  - 'modernize-*'
  - '-modernize-use-trailing-return-type'
  - '-modernize-avoid-c-arrays'
  - '-modernize-macro-to-enum'
  - '-modernize-use-designated-initializers'
  - '-modernize-use-bool-literals'
  - '-modernize-return-braced-init-list'
  - '-modernize-use-integer-sign-comparison'
  - '-modernize-use-std-print'
  - '-modernize-use-std-numbers'
  - '-modernize-deprecated-headers'
  - '-modernize-use-auto'
  - '-modernize-avoid-c-style-cast'  # Was `google-readability-casting`; functional casts like `float(v)` are the norm.
  - '-modernize-avoid-variadic-functions'  # `sform()` and the `assertx()` helpers wrap `printf`-style APIs.
  - 'readability-*'
  - '-readability-identifier-length'
  - '-readability-identifier-naming'
  - '-readability-magic-numbers'
  - '-readability-braces-around-statements'
  - '-readability-implicit-bool-conversion'
  - '-readability-function-cognitive-complexity'
  - '-readability-function-size'
  - '-readability-else-after-return'
  - '-readability-named-parameter'
  - '-readability-uppercase-literal-suffix'
  - '-readability-isolate-declaration'
  - '-readability-math-missing-parentheses'
  - '-readability-use-concise-preprocessor-directives'
  - '-readability-avoid-unconditional-preprocessor-if'
  - '-readability-avoid-nested-conditional-operator'
  - '-readability-container-size-empty'
  - '-readability-convert-member-functions-to-static'
  - '-readability-use-std-min-max'
  - '-readability-use-anyofallof'
  - '-readability-redundant-access-specifiers'
  - '-readability-container-data-pointer'
  - '-readability-avoid-return-with-void-value'
  - '-readability-simplify-boolean-expr'
  - '-readability-suspicious-call-argument'
  - '-readability-non-const-parameter'
  - '-readability-redundant-casting'
  - '-readability-trailing-comma'  # Whether a braced list ends with a comma is left to clang-format.
CheckOptions:
  modernize-use-nodiscard.ReplacementString: '[[nodiscard]]'
  bugprone-sizeof-expression.WarnOnSizeOfPointerToAggregate: false
  bugprone-empty-catch.IgnoreCatchWithKeywords: '@TODO;@FIXME;@INTENTIONAL'
  bugprone-implicit-widening-of-multiplication-result.IgnoreConstantIntExpr: true
  performance-move-const-arg.CheckTriviallyCopyableMove: false
  # Loop elements of range adaptors (e.g. the tuple from views::enumerate) are cheap to copy.
  performance-for-range-copy.AllowedTypes: '^std::ranges::'
  # Views (like pointers), scope guards, and file handles are not made const.  (Requires LLVM 21.)
  misc-const-correctness.AllowedTypes: 'hh::C?ArrayView;hh::C?GridView;hh::C?MatrixView;hh::C?StridedArrayView;hh::C?Nv12View;hh::C?VideoNv12View;hh::Timer;hh::MkSave;hh::RFile;hh::WFile;LockIMFMediaBuffer;std::scoped_lock;std::lock_guard;std::unique_lock'
HeaderFilterRegex: '.*'
SystemHeaders: false
ExcludeHeaderFilterRegex: '.*(glext|wglext|glxext|mikktspace)\.h$'
FormatStyle: file
ExtraArgsBefore:
  - '-x'
  - 'c++'
ExtraArgs:
  - '-std=c++23'
  - '-march=corei7'
  - '-msse4.1'
  - '-ffast-math'
  - '-fsigned-zeros'
  - '-ftrapping-math'
  - '-fno-associative-math'
  - '-fno-reciprocal-math'
  - '-fno-finite-math-only'
  - '-frtti'
  - '-Wno-constant-logical-operand'
  - '-D_CRT_SECURE_NO_WARNINGS'
  - '-DUNICODE'
  - '-D_UNICODE'
  - '-DHH_NO_IMAGE_IO'
  # Raise `ipa-always-inline-size` from its default of 3 CFG basic blocks.  A callee at or below this size is deemed
  # "small" and is inlined even after the analyzer's inline stack depth limit (5 frames) is reached.  `assertx_aux()`
  # (an `if` plus a `[[noreturn]]` call) exceeds 3 blocks, so past depth 5 its `[[noreturn]]` is invisible and
  # `assertx(pointer)` fails to suppress false "null dereference" reports in deep call chains.
  - '-Xclang'
  - '-analyzer-config'
  - '-Xclang'
  - 'ipa-always-inline-size=5'
