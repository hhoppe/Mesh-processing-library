#!/bin/bash
# Creates the images of the README pages (in .github/images/) by rendering demo data and results using G3dOGL and
# assembling the renderings using Filterimage.  Each image is created in a light variant (NAME.jpg) and in a dark
# variant (NAME_dark.jpg) on the background color of GitHub's dark theme.
#
# Usage: .github/scripts/create_readme_images
#
# The programs must be built (any CONFIG), and the demos create_recon_cactus, create_spherical_param_bunny, and
# create_pm_cessna must have been run (e.g., using "make -C demos create").

set -e -o pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.."
for dir in unix cygwin clang mingw win msbuild; do PATH=$PWD/bin/$dir:$PATH; done; PATH=$PWD/bin:$PATH
images=.github/images
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
height=600  # Height of the tiles within a row.
width=1760  # Width of each row (and of the images).
gap=8       # Half the spacing between tiles.
export ASSERTW_IGNORE='fl,fr._matid ignored|Isolated vertex has undefined normal|Display lists should be off'
export JPG_QUALITY=88
data=demos/data; results=demos/results

# render name geometry [args...] : render a view into $tmp/name.png, cropped to its content and scaled to $height,
# with a margin of $gap pixels (horizontally $hgap if set).
render() {
  local name=$1 geometry=$2; shift 2
  G3dOGL "$@" -noinfo 1 $viewer_args -geom "$geometry" -offscreen "$tmp/$name.raw.png" >&/dev/null </dev/null
  Filterimage "$tmp/$name.raw.png" -color $rgb 255 -cropmatte -scaletoy $height -boundaryrule border \
    -cropsides -${hgap:-$gap} -${hgap:-$gap} -$gap -$gap -to png >"$tmp/$name.png" 2>/dev/null
}

# row name tiles... : assemble the tiles into a row of width $row_width (default $width) in $tmp/name.png.
row() {
  local name=$1; shift
  (cd "$tmp" && Filterimage -assemble $# 1 "${@/%/.png}" -scaletox ${row_width:-$width} -to png >"$name.png" \
    2>/dev/null)
}

for variant in light dark; do
  if [[ $variant == dark ]]; then
    suffix=_dark; rgb='13 17 23'; foreground='.85 .85 .85'; viewer_args='-back #0d1117 -edgecolor #d8d8d8'
  else
    suffix=''; rgb='255 255 255'; foreground='0 0 0'; viewer_args=''
  fi

  # Surface reconstruction: points, initial mesh, optimized mesh, and fitted subdivision surface.
  Filtera3d $data/cactus.pts -diff $foreground 2>/dev/null >"$tmp/cactus.a3d"
  render cactus_points 640x960 "$tmp/cactus.a3d" -st $data/cactus.s3d
  render cactus_recon 640x960 $results/cactus.recon.m -st $data/cactus.s3d -key DmDe
  render cactus_subdiv 640x960 $results/cactus.sub2limit.m -st $data/cactus.s3d
  hgap=40 render cactus_points_wide 640x960 "$tmp/cactus.a3d" -st $data/cactus.s3d
  hgap=40 render cactus_recon_wide 640x960 $results/cactus.recon.m -st $data/cactus.s3d -key DmDe
  hgap=40 render cactus_opt_wide 640x960 $results/cactus.opt.m -st $data/cactus.s3d -key DmDe
  hgap=40 render cactus_subdiv_wide 640x960 $results/cactus.sub2limit.m -st $data/cactus.s3d
  # Progressive mesh at three levels of detail.
  for lod in 0.01 0.05 1.0; do
    PM_LOD_LEVEL=$lod render cessna_edges_$lod 1280x960 -pm_mode $results/cessna.pm -st $data/cessna.s3d \
      -key ,De -lightambient .4
  done
  PM_LOD_LEVEL=1.0 render cessna_full 1280x960 -pm_mode $results/cessna.pm -st $data/cessna.s3d -key , \
    -lightambient .4
  # View-dependent refinement of a terrain, textured and as a mesh.
  canyon="-eyeob $data/unit_frustum.a3d -sr_mode $data/gcanyon_4k2k.l1.srm -texturemap $data/gcanyon_color_4k2k.png
    -sr_screen_thresh 0.003846 -lightambient .7 -st $data/gcanyon_4k2k_fly2.s3d"
  render canyon_tex 1280x960 $canyon -key Dt
  render canyon_mesh 1280x960 $canyon -key De
  # Spherical parameterization: original bunny, its parameterization on the sphere (shaded using the original
  # normals), the remesh, the normal-mapped remesh, and the normal map itself.
  render bunny_orig 1100x1100 $data/bunny.orig.m -st $data/bunny.s3d
  Filtermesh $results/bunny.sphparam.m -renamekey v sph P \
    -normaltransf "$(Filterframe $data/bunny.s3d -snap_to_axes -inverse 2>/dev/null)" >"$tmp/bunny_sphere.m" \
    2>/dev/null
  render bunny_sphere 1100x1100 "$tmp/bunny_sphere.m" -st $data/unitsphere_ang.s3d
  render bunny_remesh 1100x1100 $results/bunny.spheresample.remesh.m -st $data/bunny.s3d -key DmDe
  normalmap=$results/bunny.spheresample.octaflat.unrotated.normalmap.png
  render bunny_normalmap 1100x1100 $results/bunny.spheresample.remesh.m -st $data/bunny.s3d \
    -texturemap $normalmap -texturenormal 1 -key Dt
  side=$((height * 9 / 10)); pad=$(((height - side) / 2))  # The normal map, as a square slightly smaller.
  Filterimage $normalmap -filter lanczos6 -scaletoy $side -color $rgb 255 -boundaryrule border \
    -cropsides -$gap -$gap -$pad -$pad -to png >"$tmp/normalmap.png" 2>/dev/null
  # Progressive simplicial complex at a coarse and at its full resolution.
  for lod in 0.05 1.0; do
    PSC_LOD_LEVEL=$lod render drumset_$lod 1280x960 -psc_mode $data/drumset_trunc.psc $data/drumset.box.a3d \
      -st $data/drumset.s3d -key , -lightambient .4
  done

  row overview1 cactus_points cactus_recon cactus_subdiv bunny_remesh drumset_1.0
  row overview2 cessna_edges_0.01 cessna_full canyon_tex
  Filterimage -assemble 1 2 "$tmp/overview1.png" "$tmp/overview2.png" -to jpg >$images/overview$suffix.jpg 2>/dev/null
  row_width=1440 row reconstruction cactus_points_wide cactus_recon_wide cactus_opt_wide cactus_subdiv_wide
  row progressive_mesh cessna_edges_0.01 cessna_edges_0.05 cessna_edges_1.0
  row terrain canyon_tex canyon_mesh
  row spherical bunny_orig bunny_sphere bunny_remesh bunny_normalmap normalmap
  row simplicial_complex drumset_0.05 drumset_1.0
  for name in reconstruction progressive_mesh terrain spherical simplicial_complex; do
    Filterimage "$tmp/$name.png" -to jpg >$images/$name$suffix.jpg 2>/dev/null
  done
done
# The hidden-line-removed figure of the G3dVec example in progs/README.md, as an SVG image.
FilterPM $data/spheretext.pm -nf 4000 -outmesh 2>/dev/null | Filtermesh -proc sharp_from_wid -mark 2>/dev/null |
  G3dVec -st $data/spheretext_closeup.s3d -thicksharp 3 -plotfile $images/spheretext.svg -key hDP \
    -hidden -hwdelay 1 -hwkey '\2\c' >&/dev/null
ls -l $images/*.jpg $images/*.svg | grep -vE '\.red\.jpg'
