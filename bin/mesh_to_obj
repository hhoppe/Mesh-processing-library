#!/usr/bin/env perl
# Takes a mesh and creates an obj file
# Does not deal with any info on vertices, faces, or edges.

use strict;

binmode(STDOUT);

my $gid = 0;
my %mvv;  # Mesh vertex id -> obj vertex index (1-based), so that the input need not be renumbered.

while (<>) {
  if (/^\#/) { print; next; }
  if (/^Vertex /) {
    my ($n,$x,$y,$z,$info)=/^Vertex (\d+)\s+(\S+)\s+(\S+)\s+(\S+)\s*(\{.*\})?\s*$/ or die "?";
    $mvv{$n} = ++$gid;
    printf("v %g %g %g\n",$x,$y,$z);
    next;
  }
  if (/^Face /) {
    my ($verts,$info)=/^Face \d+\s+(\d[\d\s]*\d)\s*(\{.*\})?\s*$/ or die "?";
    # warn "verts='$verts' info='$info'\n";
    my @verts=split(' ',$verts);
    print "f";
    for (@verts) { printf(" %d", $mvv{$_} // die "Face refers to undefined vertex $_\n"); }
    print "\n";
    next;
  }
}
