#!/usr/bin/env perl
# Converts Wavefront obj ascii file to a mesh.

# cd ~/tmp
# for f in *.obj; do echo '**' $f; obj_to_mesh $f >$(rname $f).m; done

use strict;
use POSIX 'strftime';
use File::Basename;

# Find Materials_lib.pm (and its Materials_rgb.db) in the directory of this script.
use FindBin;
use lib $FindBin::Bin;
use Materials_lib;

my @original_argv = @ARGV;

sub main() {
  use Getopt::Long;
  my $no_sharp_edges; my $debug; my $ignore_missing_mtl;
  GetOptions(
    "no_sharp_edges" => \$no_sharp_edges,
    "debug" => \$debug,
    "ignore_missing_mtl" => \$ignore_missing_mtl,
    ) or die("Error in command line arguments");

  binmode(STDOUT);

  my $date = strftime("%Y-%m-%d %H:%M:%S", localtime);
  my $script_name = basename($0);
  print("# Created on $date using: $script_name @original_argv\n");

  my $k_no_smoothing = "ZZ";
  my $k_default_smoothing = "1";  # Smoothing is "on" by default.
  my $smoothing_group = $k_default_smoothing;
  my $k_default_group = "default";
  my $groups = $k_default_group;
  my $k_no_material = "nomaterial";
  my $material = $k_no_material;

  my $warnings_mrgb; my $warnings_line;
  my %materials;
  my %mtl_rgb;
  my %hedge_smoothing_group;

  my @ar_p; my @ar_vt; my @ar_vn; my @ar_vrgb;
  my $vertices_last_printed = 0;
  my $gfi = 0;

  LINE: while (<>) {
    s/\cM\cJ$/\cJ/;               # Run tounix.
    if (/^v /) {
      my ($x, $y, $z, $comment) = /^v\s+(\S+)\s+(\S+)\s+(\S+)(\s+\#\w+)?\s*$/ or die "? '$_'";
      push(@ar_p, "$x $y $z");
      if ($comment) {                     # Parse color format from Phil Dench's ply2obj.
        $comment =~ s/^\s+\#//; $comment =~ s/\s*$//;
        length($comment) == 6 or die "? comment='$comment'";  # Expected 3 alphanumeric bytes.
        my @rgb; for my $i (0 .. 2) { $rgb[$i] = hex(substr($comment, $i * 2, 2)) / 255.0; }
        push(@ar_vrgb, sprintf("(%.4g %.4g %.4g)", @rgb));
      }
    } elsif (/^vt /) {
      # my ($u, $v) = /^vt\s+(\S+)\s+(\S+)\s*$/ or die "? '$_'";
      my ($u, $v, $ignore_w) = /^vt\s+(\S+)\s+(\S+)(\s*\S+\s*)?$/ or die "? '$_'";
      push(@ar_vt, "($u $v)");
    } elsif (/^vn /) {
      my ($nx, $ny, $nz) = /^vn\s+(\S+)\s+(\S+)\s+(\S+)\s*$/ or die "? '$_'";
      push(@ar_vn, "($nx $ny $nz)");
    } elsif (/^f /) {
      if (@ar_p > $vertices_last_printed) {
        for my $i ($vertices_last_printed .. @ar_p - 1) {
          my $info = "";
          if (@ar_vt == @ar_p) { $info .= " uv=$ar_vt[$i]"; }
          if (@ar_vn == @ar_p) { $info .= " normal=$ar_vn[$i]"; }
          if (@ar_vrgb == @ar_p) { $info .= " rgb=$ar_vrgb[$i]"; }
          if ($info) { $info =~ s/^ //; $info = " {$info}"; }
          my $vi = $i + 1;
          print "Vertex $vi  $ar_p[$i]$info\n";
        }
        $vertices_last_printed = @ar_p;
      }
      s/^f //; my @full_vertices = split(' ');
      my @vertices = @full_vertices;
      for (@vertices) { s@/.*$@@; }
      for (@vertices) { if ($_ < 0) { $_ = @ar_p + 1 + $_; } }
      my $rgb;
      if (@ar_vrgb) {
        $rgb = "";
      } elsif ($mtl_rgb{$material}) {
        $rgb = $mtl_rgb{$material};
      } else {
        $rgb = (" " . Materials_lib::mat_to_rgb($material, $groups));
      }
      $materials{$material}++;
      $gfi++;
      print "Face $gfi  @vertices {mat=\"$material\" groups=\"$groups\"$rgb}\n";
      for (@full_vertices) {
        next unless m@/@;
        my ($vi, $vti, $vni) = m@^(-?\d+)/(-?\d*)?(?:/(-?\d*))?$@ or die "? '$_'";
        if ($vi < 0) { $vi = @ar_p + 1 + $vi; }
        my $info = "";
        if ($vti ne "") {
          if ($vti < 0) { $vti = @ar_vt + 1 + $vti; }
          if (@ar_vt != @ar_p) { $info .= " uv=$ar_vt[$vti - 1]"; }
          elsif ($vti != $vi) { die "? $vti $vi '$_'"; }
        }
        if ($vni) {               # Not undef or "".
          if ($vni < 0) { $vni = @ar_vn + 1 + $vni; }
          if (@ar_vn != @ar_p) { $info .= " normal=$ar_vn[$vni - 1]"; }
          elsif ($vni != $vi) { die "? $vi $vni '$_'"; }
        }
        if ($info) {
          $info =~ s/^ //;
          print "Corner $vi $gfi {$info}\n";
        }
      }
      my $last_vi = $vertices[$#vertices];
      for my $vi (@vertices) {
        my $hedge = "$last_vi $vi";
        $hedge_smoothing_group{$hedge} = $smoothing_group;
        $last_vi = $vi;
      }
    } elsif (/^s\s*$/) {
      $smoothing_group = $k_default_smoothing;
    } elsif (/^s off\s*$/) {
      $smoothing_group = $k_no_smoothing;
    } elsif (/^s /) {
      ($smoothing_group) = /^s\s+(\w+)\s*$/ or die "? '$_'";
    } elsif (/^g/) {
      if (/^g$/) { $groups = $k_default_group; next; }
      ($groups) = /^g\s+(.*)\s*$/ or die "? '$_'";
    } elsif (/^usemtl /) {
      ($material) = /^usemtl\s+(\S+)\s*$/ or die "? '$_'";
    } elsif (/^l /) {
      warn "Ignoring line primitive\n" unless $warnings_line++;
    } elsif (/^\#MRGB /) {        # ZBrush vertex colors.
      if ($vertices_last_printed && !$warnings_mrgb++) { warn "#MRGB lines should be moved prior to vertices\n"; }
      # The following MRGB block contains ZBrush Vertex Color (Polypaint) and masking output as 4 hexadecimal
      # values per vertex. The vertex color format is MMRRGGBB with up to 64 entries per MRGB line.
      #MRGB 
      # ...
      # End of MRGB block
      s/^#MRGB // or die "? '$_'";
      while (s/([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])//) {
        my @rgb = ($1, $2, $3);
        for my $ch (@rgb) {
          $ch = ord(pack("H2", $ch)) / 255.0;
        }
        push @ar_vrgb, sprintf("%g %g %g", @rgb);
      }
    } elsif (/^\#/) {             # Ignore comment.
    } elsif (/^\s*$/) {           # Ignore blank lines.
    } elsif (/^mtllib *$/) {      # ignore empty material
    } elsif (/^mtllib /) {
      (my $filename) = /^mtllib (.*)\s*$/ or die "? '$_'";
      $filename =~ /\.mtl$/ or die "$filename not *.mtl";
      ## Example file1:
      # newmtl 01_-_Default
      # Ka  0.6 0.6 0.6
      # Kd  0.6 0.6 0.6
      # Ks  0.9 0.9 0.9
      # d  1.0
      # Ns  0.0
      # illum 2
      # map_Kd TextureDouble_A.png
      ## Example file2:
      # # Material Count: 4
      #
      # newmtl Material
      # Ns 96.078431
      # Ka 1.000000 1.000000 1.000000
      # Kd 0.045653 0.136372 0.640000
      # Ks 0.500000 0.500000 0.500000
      # Ke 0.000000 0.000000 0.000000
      # Ni 1.000000
      # d 1.000000
      # illum 2
      #
      # newmtl Material.005
      # Ns 96.078431
      # Ka 1.000000 1.000000 1.000000
      # Kd 0.156315 0.800000 0.754417
      # Ks 0.500000 0.500000 0.500000
      # Ke 0.000000 0.000000 0.000000
      # Ni 1.000000
      # d 1.000000
      # illum 2
      #...
      if (open(MTLLIB, $filename)) {
        my $material;
        while (<MTLLIB>) {
          if (/^newmtl (\S+)$/) { $material = $1; next; }
          if (/^Kd\s+(\S+)\s+(\S+)\s+(\S+)\s*$/) {
            die "? material='$material'" unless $material && !$mtl_rgb{$material};
            $mtl_rgb{$material} = " rgb=($1 $2 $3)";
          }
        }
        close(MTLLIB);
      } else {
        warn "mtllib file '$filename' not found\n" unless $ignore_missing_mtl;
      }
    } elsif (/^o /) {
      chop; warn "line '$_' ignored\n" if $debug;
      # chop; warn "Adding new object based on line '$_'\n";
      # printf "o 1 1 0\n";
      printf("# %s\n", $_);
    } elsif (/^\000$/) {
      # Ignore corrupt last line.
    } else {
      chop; die "could not parse line '$_'";
    }
  }

  my $num_v = @ar_p; my $num_vt = @ar_vt; my $num_vn = @ar_vn; my $num_vrgb = @ar_vrgb;
  warn "vertices: v=$num_v / vt=$num_vt / vn=$num_vn / vrgb=$num_vrgb\n";

  if (!$no_sharp_edges && !@ar_vn) {
    warn "Now looking for sharp edges\n";
    my $num_boundary_edges = 0; my $num_internal_edges = 0; my $num_sharp_edges = 0;
    for my $hedge (keys %hedge_smoothing_group) {
      my $sg1 = $hedge_smoothing_group{$hedge};
      my ($vi1, $vi2) = $hedge =~ /^(\d+) (\d+)$/ or die "? '$_'";
      next if $vi1 > $vi2;
      my $opposite_hedge = "$vi2 $vi1";
      my $sg2 = $hedge_smoothing_group{$opposite_hedge};
      if (!defined($sg2)) { $num_boundary_edges++; next; }
      $num_internal_edges++;
      next if $sg1 ne $k_no_smoothing && $sg1 eq $sg2;
      printf("Edge $vi1 $vi2 {sharp}\n"); $num_sharp_edges++;
    }
    my $total_edges = $num_boundary_edges + $num_internal_edges;
    my $s = "Of $total_edges total edges: boundary=$num_boundary_edges sharp=$num_sharp_edges\n";
    warn $s;
    printf "# $s";
  }

  for (sort keys %materials) {
    printf("# material \"%s\" %s\n", $_, $materials{$_});
  }
}

main();
