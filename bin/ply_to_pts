#!/usr/bin/env perl
# Converts the vertices of a Stanford ply file (ascii or binary) into an A3d stream of points (*.pts).

use strict;
use POSIX 'strftime';
use File::Basename;
use Sys::Hostname;
use Getopt::Long;

my $usage = <<'END_USAGE_EXAMPLES';
Usage: ply_to_pts [--no_normals] [file.ply | -]

Converts the vertices of a Stanford ply file (ascii, binary_little_endian, or binary_big_endian) into an A3d
stream of points, written to stdout.  If the vertices have the properties nx, ny, and nz, each point is preceded
by its normal ("n nx ny nz"), unless --no_normals is given.  Other vertex properties (e.g. colors) and all other
elements (e.g. faces) are ignored.  The output begins with comments giving the command and the ply header.
Each coordinate is printed with the fewest significant digits that read back as the same float.

Examples:
  ply_to_pts ~/data/recon/new/bunny.points.ply >bunny.pts
  ply_to_pts --no_normals torso.points.ply | Filtera3d -outlier 1 .002 >torso.pts
END_USAGE_EXAMPLES

my @original_argv = @ARGV;

# Unpack template letter and size of each ply scalar type.
my %k_type_info = (
  char => ['c', 1], int8 => ['c', 1], uchar => ['C', 1], uint8 => ['C', 1],
  short => ['s', 2], int16 => ['s', 2], ushort => ['S', 2], uint16 => ['S', 2],
  int => ['l', 4], int32 => ['l', 4], uint => ['L', 4], uint32 => ['L', 4],
  float => ['f', 4], float32 => ['f', 4], double => ['d', 8], float64 => ['d', 8],
);

# Returns the float values, each formatted with the fewest significant digits that read back as the same float, as
# C++ std::to_chars(float) does (except for denormals).
sub format_floats {
  return map {
    my $packed = pack('f', $_);
    my $s = sprintf('%.7g', $_);
    if (pack('f', $s) ne $packed) {
      $s = sprintf('%.8g', $_);
      $s = sprintf('%.9g', $_) if pack('f', $s) ne $packed;
    } elsif ($s =~ /[19](?:e|$)/) {
      # Six digits can suffice only if the seventh is 1 or 9, as floats are at most 0.6 seventh-digit units apart.
      my $s6 = sprintf('%.6g', $_);
      $s = $s6 if pack('f', $s6) eq $packed;
    }
    $s;
  } unpack('f*', pack('f*', @_));
}

sub main {
  my ($help, $no_normals);
  GetOptions('help' => \$help, 'no_normals' => \$no_normals) or die "ply_to_pts: bad arguments\n$usage";
  if ($help) { print $usage; exit 0; }
  @ARGV <= 1 or die "ply_to_pts: expected at most one file argument\n$usage";
  my $filename = @ARGV ? $ARGV[0] : '-';

  binmode(STDOUT);
  my $fh;
  if ($filename eq '-') {
    $fh = \*STDIN;
  } else {
    open($fh, '<', $filename) or die "ply_to_pts: cannot open '$filename': $!\n";
  }
  binmode($fh);

  # Parse the header.
  my @header_lines;
  my ($format, $nv, @props);  # Each prop is [name, type].
  my $element = '';
  my $first_element;
  while (my $line = <$fh>) {
    $line =~ s/\r?\n$//;
    push(@header_lines, $line);
    if (@header_lines == 1) {
      $line eq 'ply' or die "ply_to_pts: '$filename' does not begin with 'ply'\n";
    } elsif ($line =~ /^format\s+(\S+)\s+1\.0$/) {
      $format = $1;
    } elsif ($line =~ /^element\s+(\S+)\s+(\d+)$/) {
      $element = $1;
      $first_element //= $element;
      $nv = $2 if $element eq 'vertex';
    } elsif ($line =~ /^property\s+(.*)$/) {
      next if $element ne 'vertex';
      my @f = split(' ', $1);
      @f == 2 or die "ply_to_pts: unsupported vertex property '$line'\n";
      my ($type, $name) = @f;
      exists $k_type_info{$type} or die "ply_to_pts: unknown property type in '$line'\n";
      push(@props, [$name, $type]);
    } elsif ($line eq 'end_header') {
      last;
    } elsif ($line !~ /^(comment|obj_info)\b/) {
      die "ply_to_pts: unexpected header line '$line'\n";
    }
  }
  $header_lines[-1] eq 'end_header' or die "ply_to_pts: '$filename' has no end_header\n";
  defined $format or die "ply_to_pts: '$filename' has no format line\n";
  defined $nv or die "ply_to_pts: '$filename' has no vertex element\n";
  $first_element eq 'vertex' or die "ply_to_pts: the vertex element must come first, not '$first_element'\n";

  my %prop_index;
  for my $i (0 .. $#props) { $prop_index{$props[$i][0]} = $i; }
  my @ixyz = map { $prop_index{$_} // die "ply_to_pts: vertices lack property '$_'\n" } qw(x y z);
  my $has_normals = (grep { exists $prop_index{$_} } qw(nx ny nz)) == 3;
  my @inor = $has_normals && !$no_normals ? (map { $prop_index{$_} } qw(nx ny nz)) : ();

  # Output the comments.
  my $date = strftime('%Y-%m-%d %H:%M:%S', localtime);
  my $host = hostname();
  my $script_name = basename($0);
  print("# Created at $date on $host using:\n");
  print("#  $script_name @original_argv\n");
  print("# ply header:\n");
  print("#  $_\n") for @header_lines;
  warn("ply_to_pts: $nv vertices, format $format, " .
       (@inor ? 'with normals' : $has_normals ? 'normals omitted' : 'no normals') . "\n");

  my @iout = (@inor, @ixyz);
  my $output_vertex = sub {
    my ($values) = @_;
    my @s = format_floats(@$values[@iout]);
    if (@inor) { print("n $s[0] $s[1] $s[2]\np $s[3] $s[4] $s[5]\n"); } else { print("p $s[0] $s[1] $s[2]\n"); }
  };

  my $nprops = @props;
  if ($format eq 'ascii') {
    for my $i (1 .. $nv) {
      my $line = <$fh> // die "ply_to_pts: file ends after $i vertices\n";
      my @values = split(' ', $line);
      @values >= $nprops or die "ply_to_pts: vertex $i has too few values: '$line'\n";
      $output_vertex->(\@values);
    }
  } elsif ($format =~ /^binary_(little|big)_endian$/) {
    my $endian = $1 eq 'little' ? '<' : '>';
    my $template = '';
    my $record_size = 0;
    for my $prop (@props) {
      my ($letter, $size) = @{$k_type_info{$prop->[1]}};
      $template .= $size > 1 ? "$letter$endian" : $letter;
      $record_size += $size;
    }
    my $k_chunk = 65536;  # Number of vertices read at a time.
    for (my $i = 0; $i < $nv; $i += $k_chunk) {
      my $n = $nv - $i < $k_chunk ? $nv - $i : $k_chunk;
      my $nbytes = $n * $record_size;
      read($fh, my $buf, $nbytes) == $nbytes or die "ply_to_pts: file ends within the vertices\n";
      my @values = unpack("($template)$n", $buf);
      for my $j (0 .. $n - 1) {
        $output_vertex->([@values[$j * $nprops .. ($j + 1) * $nprops - 1]]);
      }
    }
  } else {
    die "ply_to_pts: unknown format '$format'\n";
  }
}

main();
