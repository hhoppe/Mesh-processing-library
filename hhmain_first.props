<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- This file is intended for use after the import of $(VCTargetsPath)\Microsoft.Cpp.Default.props and
       before the import of $(VCTargetsPath)\Microsoft.Cpp.props.
       It avoids the "Retarget solution" nag from VS. -->
  <!-- See MSBuild Conditions: https://learn.microsoft.com/en-us/visualstudio/msbuild/msbuild-conditions -->
  <PropertyGroup>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
  </PropertyGroup>
  <!-- Formerly an explicit mapping; superseded by $(DefaultPlatformToolset) above.
    </PropertyGroup>
    <PropertyGroup Condition="'$(VisualStudioVersion)' == '17.0'" Label="VS 2022">
      <PlatformToolset>v143</PlatformToolset>
    </PropertyGroup>
    <PropertyGroup Condition="'$(VisualStudioVersion)' == '18.0'" Label="VS 2026">
      <PlatformToolset>v145</PlatformToolset>
    </PropertyGroup>
  -->
</Project>
<!-- For Emacs:
     Local Variables:
     nxml-child-indent: 2
     End:
-->
