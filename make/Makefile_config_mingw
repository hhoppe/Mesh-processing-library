rel ?= 1#  0=debug or 1=release (usually 1).

include $(dir $(lastword $(MAKEFILE_LIST)))/Makefile_base_gcc

ifneq ($(call file_exists,c:/mingw-w64/x86_64-16.1.0-posix-seh-ucrt-rt_v14/mingw64/bin),)
  $(call prepend_PATH,c:/mingw-w64/x86_64-16.1.0-posix-seh-ucrt-rt_v14/mingw64/bin)
else
  $(error Did not find mingw-w64 directory.)
endif

graphics_libs = -lopengl32 -lwinmm -lgdi32 -lcomdlg32 -luser32

# Note: <stacktrace> is unavailable in this package: g++ leaves __cpp_lib_stacktrace undefined (libstdc++ built
#  without libbacktrace).  (The earlier StackWalker fallback in libHh/Hh.cpp requires _MSC_VER.)
# Recheck using: echo '#include <version>' | g++ -x c++ -std=c++23 -dM -E - | grep stacktrace
last_libs += -lstdc++exp#  For the Windows console path of std::print/std::println, not for stacktrace.

# Workaround for g++ 16.1.0 mingw bug: 32-byte-aligned stack stores are emitted without stack realignment.
# Adding -mstackrealign realigns to -mpreferred-stack-boundary, which is capped to 16 bytes, so does not help.
# (See related issue in Makefile_config_cygwin.)
ccommon += -mno-avx

# Static linking removes the need to have the compiler directory in PATH at runtime.
LDFLAGS += -static

