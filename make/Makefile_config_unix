release ?= 1#  0=debug or 1=release (usually 1).

ifeq ($(is_mac),1)
  cppinc += -DHH_NO_IMAGE_LIBS#  To avoid installing libjpeg and libpng; instead just use ffmpeg.
  includes += -isystem /opt/X11/include#  For XQuartz X11 on Mac; a system directory, so that its headers do not warn.
  LDFLAGS += -L/opt/X11/lib#  For XQuartz X11 on Mac.
  CC = clang#  Set default choice of compiler (clang or gcc); on Mac, gcc/g++ gets mapped to clang anyway.
  # Mac uses libc++ (rather than libstdc++) and it does not currently have stacktrace.
else
  CC = clang#  Set default choice of compiler (clang or gcc); override using "make CC=gcc ...".
  last_libs += -lstdc++exp#  For stacktrace.
endif

include $(dir $(lastword $(MAKEFILE_LIST)))Makefile_base_$(CC)

# libstdc++ implements partial_ordering::equivalent as a nullptr and gives false-positive warnings.
cpedantic += -Wno-zero-as-null-pointer-constant

ifeq ($(is_mac),1)
  # Apple Clang searches /usr/local/include (if present) as a system directory outside the SDK, and -Weverything
  #  then warns in every translation unit that it is "unsafe for cross-compilation".
  cpedantic += -Wno-poison-system-directories
  # Apple Clang's typed-allocation heuristic flags the pool operator new[] in Pool.h, which deliberately forwards
  #  to ::operator new.
  cpedantic += -Wno-allocator-wrappers
endif

ifeq ($(CC),gcc)
  LDFLAGS += -pthread  # Necessary with gcc for std::thread in VideoViewer.cpp.
  ccommon += -pthread  # Also needed at compile time so that macro symbol _REENTRANT matches the precompiled header.
endif

graphics_libs ?= -lGL -lX11
