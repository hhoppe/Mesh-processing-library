#!/bin/bash

# The grep filters ignore differences between the win and mingw configurations.
Contour_test 2>&1 | grep -v SContneval

# cat Contour_test.{2D,2Dborder,3D,3Dborder,m}
cat Contour_test.{2D,2Dborder,m} | perl -ne 'BEGIN { binmode(STDOUT); } print unless /^Face /;'

rm -f Contour_test.{2D,2Dborder,3D,3Dborder,m}
